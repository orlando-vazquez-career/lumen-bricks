# Copiar a `.env` y completar. `.env` esta en .gitignore: nunca lo commitees.
# Ninguna de estas claves debe ser una cuenta con fondos reales en mainnet.

# --- Red ---
# local | testnet | futurenet | mainnet
STELLAR_NETWORK=testnet

# Passphrase de la red. Debe coincidir con STELLAR_NETWORK.
#   local    -> "Standalone Network ; February 2017"
#   testnet  -> "Test SDF Network ; September 2015"
#   mainnet  -> "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Endpoints ---
# Con `docker compose up` local, ambos apuntan a http://localhost:8000
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# --- Identidades ---
# Alias de identidad de la CLI (`stellar keys generate <alias>`).
# Preferi SIEMPRE el alias sobre pegar la clave secreta aca.
STELLAR_ACCOUNT=deployer

# Solo para CI o automatizacion sin keystore. Debe venir de un secret manager,
# no de este archivo.
# STELLAR_SECRET_KEY=

# --- Contratos desplegados ---
# Se completan despues del primer deploy.
CONTRACT_ID_TOKEN=
CONTRACT_ID_REGISTRY=
